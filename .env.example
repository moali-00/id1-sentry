# ─── Sentry Dashboard environment ────────────────────────────────────────────
# All VITE_* vars are baked into the bundle at BUILD time as string literals.
# After changing any of these you must rebuild — a restart is not enough.

# Product name shown in the LIVE status pill.
VITE_SENTRY_DASHBOARD_TITLE=SENTRY

# Basemaps. By default the Light and Dark entries load CARTO's published MapLibre
# vector styles. Setting these switches them to a raster tile template instead —
# for air-gapped / LAN-only hosts, which usually serve plain tiles rather than a
# style document. Satellite always uses Esri World Imagery and is not overridable.
VITE_MAP_TILE_URL_LIGHT=
VITE_MAP_TILE_URL_DARK=
VITE_MAP_TILE_ATTRIBUTION=

# Elevation tiles for the 3D terrain layer. Defaults to the keyless AWS Open Data
# terrarium set. Any replacement MUST be terrarium-encoded — the reader is
# configured for that, and Mapbox-RGB tiles read as plausible but wrong heights.
VITE_TERRAIN_URL=

# Root of the monitoring API, e.g. https://api.example.com/api/v1 — no trailing
# slash. Leave empty to run entirely from the bundled fixture corpus.
VITE_API_BASE_URL=

# Root of the Sentry Flight API — live ADS-B traffic within 500 km of the island.
# No trailing slash. A separate service from VITE_API_BASE_URL, and unlike that
# one it defaults to a working host, since there is no aircraft fixture to fall
# back on. The WebSocket URL is derived from this (http->ws, https->wss), so a
# host serving the REST API must also proxy /v1/stream. Empty disables the
# aircraft layer entirely.
VITE_FLIGHT_API_BASE_URL=

# How often the activity feed re-fetches, in milliseconds.
VITE_FEED_POLL_MS=30000

# Geocoder for place-name search, used until the API owns /geocode. Defaults to
# OpenStreetMap's public Nominatim (keyless). Point at an internal Nominatim-
# compatible instance for air-gapped deployments, or set it empty to disable
# name search — the search bar still resolves coordinates and watch names.
VITE_GEOCODER_URL=


# ─── Camera feeds (server side) ──────────────────────────────────────────────
# NOT a VITE_ var. This one is read by the serverless functions in api/ at
# REQUEST time, never by the browser, so it is not baked into the bundle and a
# change takes effect on the next invocation rather than needing a rebuild. It
# must be set in the host's environment (Vercel/Netlify project settings), not
# shipped in a committed .env.
#
# Windy's webcam directory — https://api.windy.com/keys, free tier. Windy is a
# weather site, but this is a separate product: they acquired Webcams.travel in
# 2019 and api.windy.com/webcams serves that directory.
#
# It is the ONLY source in the camera layer with any coverage of India, and the
# reason it is wired at all: every other source is a road authority in Europe,
# North America, Singapore or Australia, and none of them covers the Bay of
# Bengal. There is no open camera network anywhere near Abdul Kalam Island — the
# nearest Windy entries are tourist cams on the coast around Puri, roughly 200 km
# south-west of the pad, and none of them looks at anything relevant to a trial.
#
# Leave it empty and the camera layer still works everywhere else; India simply
# has no cameras and the rail says so. Note that free-tier preview image URLs
# expire after ten minutes, which is why Windy cameras declare a 600s cadence.
WINDY_API_KEY=
