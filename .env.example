# ─── Sentry Dashboard environment ────────────────────────────────────────────
# All VITE_* vars are baked into the bundle at BUILD time as string literals.
# After changing any of these you must rebuild — a restart is not enough.

# Product name shown in the LIVE status pill.
VITE_SENTRY_DASHBOARD_TITLE=SENTRY

# Basemap tiles. Defaults are the public CARTO basemaps. Override both to serve
# tiles from an internal host on air-gapped / LAN-only deployments.
VITE_MAP_TILE_URL_LIGHT=
VITE_MAP_TILE_URL_DARK=
VITE_MAP_TILE_ATTRIBUTION=

# Root of the monitoring API, e.g. https://api.example.com/api/v1 — no trailing
# slash. Leave empty to run entirely from the bundled fixture corpus.
VITE_API_BASE_URL=

# How often the activity feed re-fetches, in milliseconds.
VITE_FEED_POLL_MS=30000

# Geocoder for place-name search, used until the API owns /geocode. Defaults to
# OpenStreetMap's public Nominatim (keyless). Point at an internal Nominatim-
# compatible instance for air-gapped deployments, or set it empty to disable
# name search — the search bar still resolves coordinates and watch names.
VITE_GEOCODER_URL=
